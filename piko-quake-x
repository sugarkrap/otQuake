#!/bin/sh
# piko-quake-x -- launch framebuffer Quake from the Matchbox desktop.
#
# Named for the piko rootfs on purpose: this is not a general otQuake entry
# point. Every step below depends on that image's specific wiring -- Xfbdev as
# the server, /etc/init.d/xsession's getty fallback, and tty1 being a respawn
# entry in inittab. On a device that boots to a bare console, or any other
# ROM, none of this is needed: use the plain `quake` launcher instead.
#
# Quake draws straight to /dev/fb0 and reads evdev; Xfbdev (kdrive) owns both
# while it runs, and it EVIOCGRABs the keyboard and touchscreen, so a Quake
# started under X renders but never receives a keystroke. There is no chvt or
# openvt in this image to hand it a VT of its own, so the only way to give
# Quake the console is to stop X for the duration and put it back afterwards.
#
# The cycle relies on how /etc/init.d/xsession is wired into inittab:
#
#   1. kill Xfbdev  -> matchbox-session exits -> xsession's fallback_to_console
#                      execs `getty ... tty1` in the same pid.
#   2. run Quake     -> it takes the now-active tty1. QUAKE_GRAB_INPUT=1 is
#                      required, not cosmetic: without the grab every keystroke
#                      also lands in that getty's login prompt.
#   3. kill the getty -> tty1 is a `respawn` entry, so init re-runs xsession and
#                      the desktop comes back on its own.
#
# Restoring X is unconditional (see restore_x below): if Quake dies, fails to
# start, or was never launched, the desktop still comes back.
#
# Tool notes for this rootfs: busybox has no kill applet and ash has no kill
# builtin, so signals go through zsh's builtin. There is no pidof or pgrep
# either, hence the /proc scan.

set -u

BIN=/mnt/card/.zaurus/usr/bin
LOCK=/tmp/piko-quake-x.lock

# Detach first: our parent (matchbox-desktop) dies with X in step 1, and a new
# session means nothing downstream can signal us through its process group.
if [ "${QUAKE_X_DETACHED:-}" != "1" ]; then
	QUAKE_X_DETACHED=1
	export QUAKE_X_DETACHED
	exec setsid "$0" "$@"
fi

# /tmp is jffs2 here, not tmpfs -- truncate rather than append so this log
# cannot grow into flash over time.
exec > /tmp/piko-quake-x.log 2>&1

# pids whose /proc/N/cmdline matches a glob. Printed space-separated.
#
# Accumulate and echo once: this busybox has no printf at all (not a builtin,
# not a binary) and its echo does not understand -n, so there is no way to
# write a partial line. Getting this wrong is not cosmetic -- an empty result
# reads as "that process is not running", which silently skips stopping X.
pids_matching() {
	_pat="$1"
	_out=""
	for _p in /proc/[0-9]*; do
		[ -r "$_p/cmdline" ] || continue
		_c=$(tr '\0' ' ' < "$_p/cmdline" 2>/dev/null)
		case "$_c" in
		$_pat) _out="$_out ${_p#/proc/}" ;;
		esac
	done
	echo "$_out"
}

signal_pids() {
	_sig="$1"
	shift
	[ -n "${*:-}" ] || return 0
	/bin/zsh -c "kill -$_sig $*" 2>/dev/null || true
}

# Wait for a pattern to stop matching. Returns 1 on timeout.
wait_gone() {
	_pat="$1"
	_n=0
	while [ "$_n" -lt "$2" ]; do
		[ -z "$(pids_matching "$_pat")" ] && return 0
		sleep 1
		_n=$((_n + 1))
	done
	return 1
}

restore_x() {
	# Killing tty1's getty is what makes init respawn xsession. If no getty is
	# there, the tty1 slot already exited and init is respawning it for us.
	_g=$(pids_matching '*getty*tty1*')
	if [ -n "$_g" ]; then
		echo "restoring desktop: signalling getty $_g"
		signal_pids TERM $_g
	else
		echo "restoring desktop: no getty on tty1, leaving init to respawn"
	fi
	rmdir "$LOCK" 2>/dev/null || true
}

# Self-test the /proc scan before trusting it. Every decision below is driven
# by pids_matching, and a broken one fails open: it reports nothing running, so
# X is left up and Quake launches under it with no keyboard. Prove the scan can
# see this very process before acting on anything it says.
if [ -z "$(pids_matching '*piko-quake-x*')" ]; then
	echo "piko-quake-x: /proc scan returned nothing for self, refusing to continue"
	exit 1
fi

# Single-instance guard. Two concurrent Quakes fight over /dev/fb0 and evdev
# and leave the screen unusable, which is exactly what a double tap produces.
if ! mkdir "$LOCK" 2>/dev/null; then
	if [ -n "$(pids_matching '*quake-fb *')" ]; then
		echo "piko-quake-x: already running"
		exit 0
	fi
	echo "piko-quake-x: clearing stale lock"
	rmdir "$LOCK" 2>/dev/null || true
	mkdir "$LOCK" 2>/dev/null || { echo "piko-quake-x: cannot take lock"; exit 1; }
fi

if [ ! -x "$BIN/quake-fb" ]; then
	echo "piko-quake-x: no card at $BIN"
	rmdir "$LOCK" 2>/dev/null || true
	exit 1
fi

trap 'restore_x' EXIT INT TERM

echo "=== stopping X ==="
xpids=$(pids_matching '*Xfbdev*')
if [ -n "$xpids" ]; then
	signal_pids TERM $xpids
	if ! wait_gone '*Xfbdev*' 15; then
		echo "X did not exit on TERM, forcing"
		signal_pids KILL $(pids_matching '*Xfbdev*')
		wait_gone '*Xfbdev*' 5 || true
	fi
else
	echo "X was not running"
fi

# Wait for xsession to reach its getty fallback, so the console it leaves on
# tty1 is settled before Quake takes the VT.
n=0
while [ "$n" -lt 20 ]; do
	[ -n "$(pids_matching '*getty*tty1*')" ] && break
	sleep 1
	n=$((n + 1))
done

echo "=== starting quake ==="
QUAKE_GRAB_INPUT=1 QUAKE_BIN="$BIN/quake-fb" \
	/usr/sbin/fbrun "$BIN/quake-fb-launcher" "$@"
echo "=== quake exited ($?) ==="

# restore_x runs from the EXIT trap.
